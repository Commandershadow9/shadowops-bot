[Unit]
Description=ShadowOps Backup-Restore-Test (monatlich)
Documentation=https://github.com/Commandershadow9/shadowops-bot
After=network-online.target

[Service]
Type=oneshot
# Webhook-URL aus EnvironmentFile (gleiche Datei wie Bot-Watchdog)
EnvironmentFile=-/home/cmdshadow/.config/shadowops-watchdog.env
ExecStart=/home/cmdshadow/shadowops-bot/scripts/backup-restore-test.sh
# Timeout 30min — backup-test prüft S3, WAL-G, mehrere DBs
TimeoutStartSec=1800
# ⚠️ Frueher stand hier `SuccessExitStatus=0 1`. Exit 1 bedeutet laut dem
# Wrapper selbst: "Backup-Test failed UND Webhook-Call fehlgeschlagen" — also
# genau der Fall, in dem NIEMAND SONST informiert wird. Ihn als Erfolg zu
# fuehren, schaltet die letzte Meldeinstanz fuer den einzigen Zustand ab, in
# dem sie gebraucht wird. Am 01.09.2026 meldete systemd deshalb `Finished`,
# obwohl der Test keine einzige Pruefung ausgefuehrt hatte (#3184).
SuccessExitStatus=0
StandardOutput=journal
StandardError=journal
