[Unit]
Description=Disk-Hygiene Watchdog — Auto-Prune + Alarm bei vollem Disk
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/shadowops-watchdog.env
# ZERODOX#3858: `systemd --user` laeuft nur mit der primaeren Gruppe — `docker`
# fehlt. Ohne `sg docker` scheiterte JEDER docker-Aufruf still (permission
# denied), und der Watchdog meldete seit jeher „builder-cache: 0" als Erfolg.
# `sg` braucht setgid; deshalb KEIN `NoNewPrivileges=true` (sonst:
# „sg: setgid() failed: Operation not permitted").
ExecStart=/usr/bin/sg docker -c "%h/shadowops-bot/scripts/disk-hygiene-watchdog.sh"
StandardOutput=journal
StandardError=journal
SyslogIdentifier=disk-hygiene-watchdog
# Bewusst KEIN PrivateTmp (ZERODOX#3858): In User-Units baut es einen
# User-Namespace, in dem die Gruppe `docker` nicht abgebildet ist —
# `sg: setgid() failed: Invalid argument`, der Dienst startet nicht. Zudem soll
# der Watchdog das ECHTE /tmp messen (DISK_EXTRA_MOUNTS), nicht ein privates,
# leeres (vgl. ~/.claude/rules/self-maintenance.md).
PrivateTmp=false

[Install]
WantedBy=default.target
